NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000,http://localhost:8000,http://127.0.0.1:8000
MONGODB_URI=<replace-with-your-mongodb-connection-string>
MONGODB_DB=pktech
JWT_SECRET=<replace-with-strong-random-secret>
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=<your-admin-email>
ADMIN_PASSWORD=<your-secure-password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail-address>
SMTP_PASS=<your-gmail-app-password>
MAIL_FROM="PK_Tech_Warrior <your-gmail-address>"
MAIL_TO=<email-to-receive-contact-form-submissions>
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-2.5-pro
